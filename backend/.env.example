# Copy to backend/.env and fill in. backend/.env is never committed.

# Model access: Vertex AI with Application Default Credentials (run `gcloud auth application-default login` once)
PALLADION_LLM_PROVIDER=vertex
PALLADION_GCP_PROJECT=
# PALLADION_GCP_LOCATION=global
# PALLADION_VERTEX_MODEL=gemini-3.5-flash-lite
# PALLADION_VERTEX_MODEL_STRONG=gemini-3.8-flash

# Or the Gemini API with a key instead of Vertex AI
# PALLADION_LLM_PROVIDER=gemini
# PALLADION_GEMINI_API_KEY=

# Optional: second opinion from Oumi Iris (off without a key)
# PALLADION_OUMI_API_KEY=
# PALLADION_OUMI_PROJECT=

# Hosted use: the desk opens only with /?key=<room key>; the public page /send stays open
# PALLADION_ROOM_KEY=

# Optional limits and behaviour
# PALLADION_LLM_DAILY_LIMIT=450
# PALLADION_LLM_RPM=10
# PALLADION_FRESH_START=false
